# AI Student Assistant - Environment Configuration Template
# Copy this file to backend/.env and fill in your actual credentials.

# Server Port
PORT=5000

# Server Environment
NODE_ENV=development

# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_api_key_here

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/ai_student_assistant
# MongoDB Atlas (Production): mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_student_assistant?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_student_assistant

# JWT Authentication Secret Key
JWT_SECRET=super_secret_ai_student_assistant_jwt_token_key_2026

# Gemini Model Identifier
GEMINI_MODEL=gemini-3.8-flash

# Frontend URL / Allowed CORS Origins in Production
CORS_ORIGIN=*
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

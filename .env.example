# AI Student Assistant - Environment Configuration Example
# Copy this file to backend/.env (or .env) and fill in your actual credentials.

# Server Port
PORT=5000

# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_api_key_here

# MongoDB Connection URI (optional - falls back to local in-memory/JSON storage if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_student_assistant

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Gemini Model Identifier
GEMINI_MODEL=gemini-3.8-flash


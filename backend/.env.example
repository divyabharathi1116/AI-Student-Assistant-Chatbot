# AI Student Assistant - Backend Configuration

# Server Port
PORT=5000

# Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_api_key_here

# MongoDB Connection String
# Example local: mongodb://127.0.0.1:27017/ai_student_assistant
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_student_assistant?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_student_assistant

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Gemini Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

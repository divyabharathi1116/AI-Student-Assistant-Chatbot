# AI Student Assistant - Backend Configuration
# Copy this file to backend/.env and customize with your credentials

# Server Port (default 5000)
PORT=5000

# Server Environment (development | production)
NODE_ENV=development

# Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/ai_student_assistant
# MongoDB Atlas (Production): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_student_assistant?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_student_assistant

# JWT Authentication Secret Key
JWT_SECRET=super_secret_ai_student_assistant_jwt_token_key_2026

# Gemini Model Identifier (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# CORS Allowed Origins for Production Frontend
# Comma-separated list or single URL (e.g. https://your-frontend.pages.dev,https://your-frontend.vercel.app)
# Use * to allow all origins
CORS_ORIGIN=*
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
